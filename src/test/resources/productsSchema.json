{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "responseCode": {
      "type": "integer"
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "price": {
            "type": "string",
            "pattern": "^Rs\\. \\d+$" 
          },
          "brand": {
            "type": "string"
          },
          "category": {
            "type": "object",
            "properties": {
              "usertype": {
                "type": "object"
              },
              "category": {
                "type": "string"
              }
            },
            "required": ["usertype", "category"]
          }
        },
        "required": ["id", "name", "price", "brand", "category"]
      }
    }
  },
  "required": ["responseCode", "products"]
}