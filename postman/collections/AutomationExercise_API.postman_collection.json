  "item": [
    {
      "name": "Get All Products",
      "event": [
        {
          "listen": "test",
          "script": {
            "id": "d4215db0-04ff-4281-9af0-9c114843b478",
            "exec": [
              "pm.test(\"Status code is 200\", function() {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"api response code is 200\", function() {",
              "    pm.expect(jsonData.responseCode).to.eql(200);",
              "});",
              "pm.test(\"product list is empty\", function() {",
              "    pm.expect(jsonData.products.length).to.be.above(0);",
              "});"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
      "id": "04109ca4-ec56-4cfc-bd41-78ee5b335116",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/productsList",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "productsList"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Create Account",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "id": "334a1355-6624-4c37-8c4c-2d33e1dd6ba7",
            "exec": [
              "var randomNum = Math.floor(Math.random() * 100000);",
              "var randomEmail = \"postman1_user_\" + randomNum + \"@test.com\";",
              "pm.environment.set(\"currentEmail\", randomEmail);",
              "pm.environment.set(\"currenPassword\", \"123456\");",
              "console.log(\"mail:\" + randomEmail);"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "id": "833d7aa6-59cd-4219-9f0a-2f03dc42c6bc",
            "exec": [
              "pm.test(\"Status code is success\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "",
              "var jsonData = pm.response.json();",
              "pm.test(\"User created message check\", function () {",
              "    pm.expect(jsonData.message).to.eql(\"User created!\");",
              "});"
            ],
            "type": "text/javascript",
            "packages": {}
